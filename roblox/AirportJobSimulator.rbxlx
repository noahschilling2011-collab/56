local function gse(name, x, z, yaw, build)
	local m = Instance.new("Model"); m.Name = name; m.Parent = deco2
	build(m)
	m:PivotTo(CFrame.new(x * M, 0, z * M) * CFrame.Angles(0, yaw, 0))
end
