	local up2 = mpart(mega, "KIncline2", 1.7, 0.2, 5.2, -44, -2.6, 264.6, Color3.fromRGB(96, 103, 116), { CanCollide = false })
	up2.CFrame = up2.CFrame * CFrame.Angles(-0.6, 0, 0)
