-- Credit-Popups
function creditPop(n)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = UDim2.new(0, 30, 0, 116)
	l.Size = UDim2.new(0, 200, 0, 26)
